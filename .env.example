# カーリルAPI（図書館貸出状況） https://calil.jp/doc/api.html で利用申請して取得
CALIL_APPKEY=your_calil_appkey_here

# 楽天ウェブサービス（楽天ブックスAPI・ランキング） https://webservice.rakuten.co.jp/ で取得
RAKUTEN_APP_ID=your_rakuten_application_id_here
RAKUTEN_ACCESS_KEY=your_rakuten_access_key_here
# アプリ管理画面の「許可されたWebサイト」に登録したURL（Referer/Originとして送信される）
RAKUTEN_ALLOWED_SITE_URL=https://example.com

PORT=3000
