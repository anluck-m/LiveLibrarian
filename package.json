{
  "name": "livelibrarian",
  "version": "1.0.0",
  "description": "カーリルAPI（図書館貸出状況）と楽天ブックスAPI（ランキング）を組み合わせて、近くの図書館で借りられる人気本ランキングを表示するアプリ（Web／デスクトップ両対応）",
  "author": "manaki",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "electron": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.livelibrarian.desktop",
    "productName": "LiveLibrarian",
    "directories": {
      "output": "C:/Users/manak/livelibrarian-build"
    },
    "files": [
      "electron/**",
      "server.js",
      "src/**",
      "public/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
